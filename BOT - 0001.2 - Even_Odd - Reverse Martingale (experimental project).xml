<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable id="stake" islocal="false" iscloud="false">Stake Amount</variable>
    <variable id="martingale" islocal="false" iscloud="false">Martingale Multiplier</variable>
    <variable id="stoploss" islocal="false" iscloud="false">Stop Loss</variable>
    <variable id="takeprofit" islocal="false" iscloud="false">Take Profit</variable>
    <variable id="condition" islocal="false" iscloud="false">Trade Condition</variable>
  </variables>

  <!-- TRADE DEFINITION -->
  <block type="trade_definition" id="trade1" x="20" y="20" collapsed="true">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- BOT VARIABLES SET -->
    <statement name="INITIALIZATION">
      <block type="variables_set">
        <field name="VAR">Stake Amount</field>
        <value name="VALUE">
          <block type="math_number"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR">Martingale Multiplier</field>
            <value name="VALUE">
              <block type="math_number"><field name="NUM">2</field></block>
            </value>
            <next>
              <block type="variables_set">
                <field name="VAR">Stop Loss</field>
                <value name="VALUE">
                  <block type="math_number"><field name="NUM">20</field></block>
                </value>
                <next>
                  <block type="variables_set">
                    <field name="VAR">Take Profit</field>
                    <value name="VALUE">
                      <block type="math_number"><field name="NUM">30</field></block>
                    </value>
                    <next>
                      <block type="variables_set">
                        <field name="VAR">Trade Condition</field>
                        <value name="VALUE">
                          <block type="text"><field name="TEXT">Even</field></block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- TRADE OPTIONS (Stake / Duration) -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions">
        <mutation has_first_barrier="false" has_second_barrier="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <block type="math_number"><field name="NUM">1</field></block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get"><field name="VAR">Stake Amount</field></block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BEFORE PURCHASE -->
  <block type="before_purchase" id="before1" x="20" y="220" collapsed="true">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get"><field name="VAR">Trade Condition</field></block>
            </value>
            <value name="B"><block type="text"><field name="TEXT">Even</field></block></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase"><field name="PURCHASE_LIST">DIGITEVEN</field></block>
        </statement>
        <statement name="ELSE">
          <block type="purchase"><field name="PURCHASE_LIST">DIGITODD</field></block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- AFTER PURCHASE -->
  <block type="after_purchase" id="after1" x="20" y="320" collapsed="true">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if">
        <!-- Stop Loss Condition -->
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">LTE</field>
            <value name="A"><block type="total_profit"></block></value>
            <value name="B"><block type="math_single"><field name="OP">NEG</field>
              <value name="NUM"><block type="variables_get"><field name="VAR">Stop Loss</field></block></value>
            </block></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="trade_again"><field name="TRADEAGAIN">FALSE</field></block>
        </statement>

        <!-- Take Profit Condition -->
        <next>
          <block type="controls_if">
            <value name="IF0">
              <block type="logic_compare">
                <field name="OP">GTE</field>
                <value name="A"><block type="total_profit"></block></value>
                <value name="B"><block type="variables_get"><field name="VAR">Take Profit</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="trade_again"><field name="TRADEAGAIN">FALSE</field></block>
            </statement>

            <!-- Else use Martingale -->
            <next>
              <block type="variables_set">
                <field name="VAR">Stake Amount</field>
                <value name="VALUE">
                  <block type="math_arithmetic">
                    <field name="OP">MULTIPLY</field>
                    <value name="A"><block type="variables_get"><field name="VAR">Stake Amount</field></block></value>
                    <value name="B"><block type="variables_get"><field name="VAR">Martingale Multiplier</field></block></value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
